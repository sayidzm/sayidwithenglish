# Public project URL and publishable key (legacy anon key is also supported).
# Never put a service_role or sb_secret key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trusted origin used for email redirects; change this when deploying.
APP_URL=http://localhost:3000
# Server-only Google Gemini configuration. Never prefix AI_API_KEY with NEXT_PUBLIC_.
AI_PROVIDER=google
AI_MODEL=gemini-3.8-flash
AI_API_KEY=-
